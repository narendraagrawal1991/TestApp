@model IEnumerable<OfficeApp.DTOs.VehicleOwnerDto>

@{
    ViewData["Title"] = "Vehicle Master";
}

<h2>Vehicle Master</h2>

<p>
    <a asp-action="Create" class="btn btn-primary">+ Add Vehicle</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Vehicle No</th>
            <th>Owner Name</th>
            <th>Owner Mobile</th>
            <th>Driver Name</th>
            <th>Driver Mobile</th>
            <th>RC No</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>@item.VehicleNo</td>
                    <td>@item.OwnerName</td>
                    <td>@item.OwnerMobileNo1, @item.OwnerMobileNo2</td>
                    <td>@item.DriverName</td>
                    <td>@item.DriverMobileNo1, @item.DriverMobileNo2</td>
                    <td>@item.RCNo</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm">View</a>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No vehicle owners found.</td>
            </tr>
        }
    </tbody>
</table>
